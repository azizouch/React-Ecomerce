# Copy this file to .env.local (or .env) and fill the values with your Supabase project details
# Never commit real secrets to version control. Keep the real keys in .env.local or environment variables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

